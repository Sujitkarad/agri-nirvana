# ML Model Configuration
# "real" = real ML inference (MobileNetV2 + PlantVillage model)
# "mock" = mock fallback for dev without ML dependencies
AI_MODEL_PROVIDER=real

# HuggingFace model ID for plant disease classification
HF_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Confidence threshold - predictions below this show "uncertain" warning
AI_CONFIDENCE_THRESHOLD=0.50

MAX_IMAGE_SIZE_MB=10

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agri_nirvana

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
