# Agri Nirvana production configuration
AI_MODEL_PROVIDER=real
HF_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Predictions below this confidence are rejected/abstained from.
AI_CONFIDENCE_THRESHOLD=0.70

MAX_IMAGE_SIZE_MB=10

# Comma-separated frontend origins. Never use '*' in production.
# Add your exact production frontend/custom domain here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://agri-nirvana.vercel.app

# Database
MONGODB_URI=mongodb://localhost:27017/agri_nirvana
DATABASE_NAME=agri_nirvana
SQLITE_FALLBACK_DB=backend/db/history.db

# Frontend
# Set this to the deployed FastAPI backend URL in the Vercel project environment.
VITE_API_BASE_URL=http://localhost:8000

# Gemini Vision API Key (Optional: enables Gemini Pro Vision AI as primary/secondary vision engine)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
