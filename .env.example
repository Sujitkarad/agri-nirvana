# Agri Nirvana production configuration
AI_MODEL_PROVIDER=real
# One production model only. No silent Hugging Face fallback.
LOCAL_TRAINED_MODEL_PATH=backend/ml/models/weights/agri_nirvana_efficientnet_v2_s.pt
AI_REQUIRE_LOCAL_CHECKPOINT=true

# Predictions below this confidence are rejected/abstained from.
AI_CONFIDENCE_THRESHOLD=0.70
AI_MIN_TOP2_MARGIN=0.10
AI_MAX_NORMALIZED_ENTROPY=0.90
AI_MIN_CROP_PROBABILITY_MASS=0.45

MAX_IMAGE_SIZE_MB=10

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://agri-nirvana.vercel.app

MONGODB_URI=mongodb://localhost:27017/agri_nirvana
DATABASE_NAME=agri_nirvana
SQLITE_FALLBACK_DB=backend/db/history.db

VITE_API_BASE_URL=http://localhost:8000

# Backend-only secrets. Generate a unique 32+ character JWT_SECRET.
JWT_SECRET=replace_with_a_long_random_secret_32_chars_minimum

# Optional Gemini Vision provider (backend only).
GEMINI_API_KEY=your_gemini_api_key_here
